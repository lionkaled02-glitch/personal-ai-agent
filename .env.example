# Copy this file to .env and adjust. .env is git-ignored (see .gitignore).
# NEVER put real secrets or real API keys in this file — placeholders only.

AGENT_NAME=personal-agent
LOG_LEVEL=INFO
# Directory for runtime data (uploads, generated output, workspace).
DATA_ROOT=data

# --- Model gateway / provider (Phase 1) -----------------------------------
# Provider selection. "mock" is fully offline and needs no API key (default).
# Other supported values: openai
MODEL_PROVIDER=mock
# Model name for the selected provider (optional; provider default applies
# when empty — e.g. gpt-4o-mini for openai).
# MODEL_NAME=
# Seconds before a provider request times out (default: 60).
MODEL_TIMEOUT_S=60
# Gateway retries AFTER the first attempt for transient failures
# (timeout / 5xx / 429 / connection). Total attempts = 1 + this (default: 2).
MODEL_MAX_RETRIES=2

# --- OpenAI (only used when MODEL_PROVIDER=openai) -------------------------
# Required for the OpenAI provider. NEVER commit real keys.
# OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (local servers, proxies, etc.).
# OPENAI_BASE_URL=

# --- Workspace filesystem tools (Phase 3) -----------------------------------
# Root of the workspace boundary. All filesystem tools resolve paths against
# this directory and reject anything that resolves outside it. Use a path you
# are comfortable letting the agent read/write. Do NOT point this at your home
# directory, system directories, or anything containing secrets.
WORKSPACE_ROOT=data/workspace
# Largest file (bytes) the read/copy tools will process (default: 1048576).
# WORKSPACE_MAX_READ_BYTES=1048576
# Largest content (bytes) the write tool will accept (default: 1048576).
# WORKSPACE_MAX_WRITE_BYTES=1048576
# Max entries returned by list_directory (default: 500).
# WORKSPACE_MAX_LIST_ENTRIES=500
# Max matches returned by search_files (default: 200).
# WORKSPACE_MAX_SEARCH_RESULTS=200
# Max resolved workspace-relative path length in characters (default: 512).
# WORKSPACE_MAX_PATH_LENGTH=512

# --- Document processing & knowledge (Phase 4) ------------------------------
# Document tools read through the SAME workspace boundary as Phase 3 (they
# never see host paths). PDF/DOCX/PPTX/XLSX parsing additionally requires the
# optional `docs` extra (pypdf, python-docx, python-pptx, openpyxl); TXT and
# Markdown parse without any extra. All content is treated as untrusted data.
# Largest raw document (bytes) any tool will parse (default: 10485760 = 10 MiB).
# DOCUMENT_MAX_INPUT_BYTES=10485760
# Total extracted text budget across all sections, in characters (default: 500000).
# DOCUMENT_MAX_EXTRACTED_CHARS=500000
# Container caps before extraction truncates (with an explicit warning).
# DOCUMENT_MAX_PAGES=200
# DOCUMENT_MAX_SLIDES=100
# DOCUMENT_MAX_SHEETS=20
# Max sections per normalized document (default: 500).
# DOCUMENT_MAX_SECTIONS=500
# Max chunks per document at indexing time (default: 500).
# DOCUMENT_MAX_CHUNKS=500
# Chunking: max characters per chunk (default: 800) and the overlap carried
# between consecutive chunks (default: 100, must be < chunk size).
# DOCUMENT_CHUNK_SIZE=800
# DOCUMENT_CHUNK_OVERLAP=100
# Retrieval: max results returned by search_documents (default: 10) and the
# max query length in characters (default: 500).
# DOCUMENT_MAX_SEARCH_RESULTS=10
# DOCUMENT_MAX_QUERY_CHARS=500

# --- Memory & RAG (Phase 5) -------------------------------------------------
# Memory creation is EXPLICIT (remember tool / trusted internal code) — nothing
# is auto-saved. Memory and document content is untrusted DATA. Retrieval is
# lexical (no embeddings in this phase). No secrets in memory by default:
# credential-looking content is rejected at write time (heuristic, not a
# guarantee — never store credentials in memory at all).
# Max memories the store will hold (default: 1000).
# MEMORY_MAX_ITEMS=1000
# Max characters of memory content (also bounds recall/context queries;
# default: 4000).
# MEMORY_MAX_CONTENT_CHARS=4000
# Max serialized metadata size per memory, bytes (default: 4096).
# MEMORY_MAX_METADATA_BYTES=4096
# Max results returned by recall/list_memories (default: 10).
# MEMORY_MAX_RECALL_RESULTS=10
# RAG context budget: max total characters (default: 8000) and max items
# (default: 20). Omitted items are reported, never dropped silently.
# MEMORY_MAX_CONTEXT_CHARS=8000
# MEMORY_MAX_CONTEXT_ITEMS=20
# Automatic TTLs (seconds) applied to memories WITHOUT an explicit expiration.
# Only short_term and working get one; long_term and knowledge never expire
# implicitly (long-term protection).
# MEMORY_SHORT_TERM_TTL_S=3600
# MEMORY_WORKING_TTL_S=86400

# --- Computer Agent Foundation (Phase 6) ------------------------------------
# Computer tools are registered explicitly with a provider; no desktop control
# is enabled automatically by these settings. Limits fail closed.
# Max attempted computer actions per task (default 20, hard cap 500).
# COMPUTER_MAX_ACTIONS_PER_TASK=20
# Cooperative provider-action timeout in seconds (default 5, max 30).
# Blocking OS APIs cannot be forcibly interrupted by this synchronous core.
# COMPUTER_ACTION_TIMEOUT_S=5
# Max literal text characters accepted by one type_text call (default 256).
# COMPUTER_MAX_TEXT_INPUT_CHARS=256
# Max screenshot PNG payload (default 1048576; hard cap 4194304 bytes).
# COMPUTER_MAX_SCREENSHOT_BYTES=1048576
# Max visible windows and UI elements returned (defaults 50 and 100).
# COMPUTER_MAX_WINDOWS=50
# COMPUTER_MAX_UI_ELEMENTS=100
# Max automatic retries (default 1; hard cap 3). Only safe idempotent
# operations such as pointer movement/focus may retry; clicks and typing never do.
# COMPUTER_MAX_RETRIES=1
# Maximum mouse-movement duration (default 0.5 seconds; hard cap 2).
# COMPUTER_MOUSE_MOVE_DURATION_S=0.5
# Cursor verification tolerance (default 2 pixels; hard cap 10).
# COMPUTER_CURSOR_TOLERANCE_PX=2
