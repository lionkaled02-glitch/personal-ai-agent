# Copy this file to .env and adjust. .env is git-ignored (see .gitignore).
# NEVER put real secrets or real API keys in this file — placeholders only.
#
# The Phase 0 foundation needs NO API keys at all (the mock provider is the
# default). Keys below are reserved for future phases and must stay empty
# until a real provider adapter is implemented.

AGENT_NAME=personal-agent
LOG_LEVEL=INFO
# Directory for runtime data (uploads, generated output, workspace).
DATA_ROOT=data

# --- Reserved for future phases (leave empty until used) ---
# Selects the model provider implementation (only "mock" exists today).
# MODEL_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
